      "scroll_region_upper",
      "scroll_region_lower",
      "mouse_standard_flag",
      "mouse_button_flag",
      "mouse_all_flag",
      "mouse_sgr_flag",
      "synchronized_output_flag"
    ],
    "terminal_reply_owner": "tmux's real pane terminal; normalized-frame consumers do not forward emulator replies"
  },
  "geometry": { "columns": 8, "rows": 3 },
