// Authored architecture for Sidecar. Evidence paths are relative to the repository root.
// Status: Fractal's #proposed tag marks planned work and shows only in proposed scenes;
// untagged elements are current. For the UI API (api, termproto, uiclients, cli.api_*),
// current includes U0, U1-a events, U1-b schema/fixtures and the reviewed U1-c service adapter; #proposed means remaining work in
// docs/plans/active/sidecar-ui-api.md. Each proposed description names its milestone.
specification {
  element subsystem
  element component
  element adapter
  element service
  element store
  element actor
  relationship calls
  relationship sends
  relationship reads
  relationship writes
  relationship streams
  relationship manages
  relationship renders
  relationship supplies
  relationship notifies
  tag current
  tag proposed
}

model {
  user = actor 'Developer or Agent' {
    description 'Operates Sidecar through interactive keybindings or non-interactive shell commands.'
    metadata { uid 'user' fractalColor '#759EB5' evidence 'README.md' }
  }

  tui = subsystem 'Interactive TUI Client' {
    description 'Bubble Tea application managing tabs, modals, focus, and multi-surface rendering.'
    metadata { uid 'tui' fractalColor '#759EB5' evidence ['internal/app/model.go', 'internal/app/ui.go'] }

    app = component 'App Runtime & Loop' {
      description 'Main Bubble Tea model dispatching messages, commands, and keymap contexts.'
      metadata { uid 'tui.app' fractalColor '#759EB5' evidence ['internal/app/model.go', 'internal/app/view.go'] }
    }

    overview = component 'Cross-Project Sessions' {
      description 'Global workspaces browser categorizing sessions by status with live preview.'
      metadata { uid 'tui.overview' fractalColor '#759EB5' evidence ['internal/overview/model.go', 'internal/overview/workspaces.go'] }
    }

    config = component 'In-App Configuration' {
      description 'Interactive setup, diagnostics, theme switcher, and system repairs.'
      metadata { uid 'tui.config' fractalColor '#759EB5' evidence ['internal/configui/model.go', 'internal/configui/page_setup.go'] }
    }

    notify = component 'Notification Center & Toasts' {
      description 'Manages toast stacks, actionable CTA jump targets, and in-app alerts.'
      metadata { uid 'tui.notify' fractalColor '#759EB5' evidence ['internal/app/notifications.go', 'internal/app/toast_stack.go'] }
    }
  }

  panes = subsystem 'Pane & Layout Engine' {
    description 'Unified pane tree, chrome compositor, and live-watching subsystem shared across surfaces.'
    metadata { uid 'panes' fractalColor '#739886' evidence ['internal/panelayout/panelayout.go', 'internal/paneframe/paneframe.go'] }

    layout = component 'Split-Tree Geometry' {
      description 'Recursive split tree (rows/columns) computing bounds, floors, and addresses.'
      metadata { uid 'panes.layout' fractalColor '#739886' evidence ['internal/panelayout/panelayout.go', 'internal/panelayout/grid.go'] }
    }

    frame = component 'Pane Frame & Compositor' {
      description 'Renders border chrome, focus rings, headers, and drag handles with hit regions.'
      metadata { uid 'panes.frame' fractalColor '#739886' evidence ['internal/paneframe/paneframe.go', 'internal/paneframe/compose.go'] }
    }

    live = component 'Live Refresh Watcher' {
      description 'Monitors filesystem signals and refreshes only visible, on-screen pane leaves.'
      metadata { uid 'panes.live' fractalColor '#739886' evidence ['internal/livepanes/livepanes.go', 'internal/livewatch/watch.go'] }
    }

    content = component 'Content Deck & Panes' {
      description 'Renders syntax-highlighted files, diffs, notes, issues, and external resources.'
      metadata { uid 'panes.content' fractalColor '#739886' evidence ['internal/contentpanes/deck.go', 'internal/contentpanes/source.go'] }
    }
  }

  terminal = subsystem 'Terminal Fidelity Engine' {
    description 'High-fidelity terminal row capture, tmux control mode, and native PTY routing.'
    metadata { uid 'terminal' fractalColor '#B59669' evidence ['internal/termpreview/termpreview.go', 'internal/tty/control_manager.go'] }

    preview = component 'Row Capture & Fidelity' {
      description 'Preserves background color fidelity via capture-pane -e -N without row flickering.'
      metadata { uid 'terminal.preview' fractalColor '#B59669' evidence ['internal/termpreview/termpreview.go', 'internal/termpreview/rows.go'] }
    }

    control = component 'tmux Control Connection' {
      description 'Manages asynchronous control-mode connection to tmux with screen snapshot parsing.'
      metadata { uid 'terminal.control' fractalColor '#B59669' evidence ['internal/tty/control_manager.go', 'internal/tty/control_protocol.go'] }
    }

    pty = component 'PTY & Input Routing' {
      description 'Routes keystrokes, native mouse selection, paste, and wheel scroll events.'
      metadata { uid 'terminal.pty' fractalColor '#B59669' evidence ['internal/tty/tty.go', 'internal/tty/session.go'] }
    }
  }

  workspaces = subsystem 'Workspace & Shell Lifecycle' {
    description 'Manages interactive shells, git worktree workspaces, and crash-resilient session state.'
    metadata { uid 'workspaces' fractalColor '#89A579' evidence ['internal/plugins/workspace/plugin.go', 'internal/shellstate/shellstate.go'] }

    surface = component 'Workspace Surface' {
      description 'Hosts interactive agent terminals beside split panes and worktree switchers.'
      metadata { uid 'workspaces.surface' fractalColor '#89A579' evidence ['internal/plugins/workspace/plugin.go', 'internal/plugins/workspace/pane_host.go'] }
    }

    state = store 'Durable Shell Records' {
      description 'Persists shell and session metadata in shells.json across process lifetimes.'
      metadata { uid 'workspaces.state' fractalColor '#89A579' evidence ['internal/shellstate/shellstate.go', 'internal/shellstate/snapshot.go', 'internal/shellstate/session.go'] }
    }

    restore = component 'Cold Session Restore' {
      description 'Plans and executes safe recovery of shells after unexpected tmux server death.'
      metadata { uid 'workspaces.restore' fractalColor '#89A579' evidence ['internal/sessionrestore/plan.go', 'internal/sessionrestore/execute.go'] }
    }

    git_ops = component 'Worktree & Branch Ops' {
      description 'One state-free workspace operation service sequences confirmed creation, recovery journals, setup and launch, plus shell and worktree mutations, for CLI and both TUI surfaces.'
      metadata { uid 'workspaces.git_ops' fractalColor '#89A579' evidence ['internal/workspaceops/service.go', 'internal/workspaceops/worktree.go', 'internal/workspacecreate/form.go'] }
    }
  }

  agents = subsystem 'Agent Integration & Control' {
    description 'Tracks coding agent lifecycles, installs integration assets, and orchestrates secondary agents.'
    metadata { uid 'agents' fractalColor '#9A91C4' evidence ['internal/agentintegration/install.go', 'internal/agentcontrol/service.go'] }

    catalog = component 'Agent Catalog' {
      description 'Defines supported agent families, argv templates, and launch configurations.'
      metadata { uid 'agents.catalog' fractalColor '#9A91C4' evidence ['internal/agentcatalog/agentcatalog.go', 'internal/agentcatalog/installed.go'] }
    }

    integration = component 'Asset Injection & Hooks' {
      description 'Installs non-intrusive lifecycle hooks and extensions into agent configuration directories.'
      metadata { uid 'agents.integration' fractalColor '#9A91C4' evidence ['internal/agentintegration/install.go', 'internal/agentintegration/hookconfig.go'] }
    }

    lifecycle = component 'Lifecycle & Status' {
      description 'Tracks agent states (running, waiting_for_input, idle) and session identities.'
      metadata { uid 'agents.lifecycle' fractalColor '#9A91C4' evidence ['internal/agentlifecycle/registry.go', 'internal/agentlifecycle/report.go'] }
    }

    control = component 'Agent Coordination Driver' {
      description 'Discovers, starts, prompts, reads, and sends keys to agents behind safety gates.'
      metadata { uid 'agents.control' fractalColor '#9A91C4' evidence ['internal/agentcontrol/service.go', 'internal/agentcontrol/interact.go'] }
    }

    adapters = adapter 'History & Session Adapters' {
      description 'Parses chat transcripts and session logs from Claude, Codex, Cursor, Pi, and Warp.'
      metadata { uid 'agents.adapters' fractalColor '#9A91C4' evidence ['internal/adapter/adapter.go', 'internal/adapter/claudecode/adapter.go'] }
    }
  }

  notifications = subsystem 'Notification & Alert System' {
    description 'Unified alerts across in-app toasts, OS desktop banners, and terminal sounds.'
    metadata { uid 'notifications' fractalColor '#D4A373' evidence ['internal/notify/store.go', 'internal/notifydelivery/delivery.go'] }

    store = store 'Durable Notification Store' {
      description 'Persists alerts, unread counts, and jump targets in JSONL ledgers.'
      metadata { uid 'notifications.store' fractalColor '#D4A373' evidence ['internal/notify/store.go', 'internal/notify/notify.go'] }
    }

    delivery = service 'Platform Delivery' {
      description 'Dispatches native desktop notifications and sound assets on macOS and Linux.'
      metadata { uid 'notifications.delivery' fractalColor '#D4A373' evidence ['internal/notifydelivery/delivery.go', 'internal/notifydelivery/platform_darwin.go'] }
    }
  }

  cli = subsystem 'Non-Interactive CLI' {
    description 'Command-line entry points for programmatic layout, agent control, opening panes, and scripting.'
    metadata { uid 'cli' fractalColor '#82A6B6' evidence ['internal/cli/cli.go', 'internal/cli/registry.go'] }

    dispatch = component 'Command Router & Safety Gate' {
      description 'Fast-paths non-interactive verbs, verifies state isolation, and strips flags.'
      metadata { uid 'cli.dispatch' fractalColor '#82A6B6' evidence ['internal/cli/cli.go', 'internal/cli/command.go'] }
    }

    layout_cmd = component 'Layout Commands' {
      description 'sidecar layout get, apply, and move verbs for programmatic grid manipulation.'
      metadata { uid 'cli.layout_cmd' fractalColor '#82A6B6' evidence ['internal/cli/layout.go', 'internal/cli/layout_run.go'] }
    }

    agent_cmd = component 'Agent Control Commands' {
      description 'sidecar agent list, start, prompt, read, and send-keys orchestration CLI.'
      metadata { uid 'cli.agent_cmd' fractalColor '#82A6B6' evidence ['internal/cli/agent.go', 'internal/cli/agent_lifecycle.go'] }
    }

    open_cmd = component 'Open Pane Commands' {
      description 'sidecar open displays files, td issues, notes, diffs, or provider resources.'
      metadata { uid 'cli.open_cmd' fractalColor '#82A6B6' evidence ['internal/cli/open.go', 'internal/cli/open_target.go'] }
    }

    notify_cmd = component 'Notification Commands' {
      description 'sidecar notify post, list, and dismiss verbs with deep-link jump targets.'
      metadata { uid 'cli.notify_cmd' fractalColor '#82A6B6' evidence ['internal/cli/notify.go', 'internal/notifydelivery/delivery.go'] }
    }

    api_cmd = component 'API Commands' {
      summary 'sidecar api serve, open, pair, status and service'
      description 'sidecar api serve runs the UI API host in the foreground; api open, api pair and api status discover it from endpoint.json and talk to it over the Local socket. api service manages the per-user launchd or systemd job through its service-manager adapter.'
      metadata { uid 'cli.api_cmd' fractalColor '#82A6B6' evidence ['internal/cli/api.go'] }
    }

    mobile_cmd = component 'Mobile Commands' {
      summary 'sidecar mobile serve --stdio and mobile sessions'
      description 'sidecar mobile serve --stdio serves one terminal protocol stream on stdin and stdout, through the hub or the local owner service (--owner-only when a hub forwards to this machine); sidecar mobile sessions --json prints the catalog.'
      metadata { uid 'cli.mobile_cmd' fractalColor '#82A6B6' evidence ['internal/cli/mobile.go', 'internal/cli/mobile_router.go'] }
    }

    api_service = adapter 'API Service Adapter' {
      summary 'Per-user launchd or systemd service'
      description 'Implemented in U1-c: api service install, uninstall and status use the Manager interface, with launchd on macOS, systemd user units on Linux, and fake managers for tests. The job runs api serve with the recorded config and stable executable link. Config api.uiDir supplies the UI directory. Executable replacement triggers a clean exit and manager restart. Status names installation, loading, process PID, actual server version and last termination. No service operation starts, stops or restarts tmux.'
      metadata { uid 'cli.api_service' fractalColor '#82A6B6' evidence ['internal/apiservice/service.go', 'internal/apiservice/definition.go', 'internal/apiservice/status.go', 'internal/cli/api_service.go', 'internal/uiapi/executable.go', 'packaging/homebrew/sidecar.rb.tmpl', 'scripts/ui-api-service-proof.sh'] }
    }
  }

  plugins = subsystem 'Domain Plugins' {
    description 'Dedicated domain views for Git status, file browsing, task management, and notes.'
    metadata { uid 'plugins' fractalColor '#739886' evidence ['internal/plugin/plugin.go', 'internal/plugins/assembly/assembly.go'] }

    git = component 'Git Status & Diffs' {
      description 'Staged and unstaged file inspection, syntax-highlighted diffs, and commit logs.'
      metadata { uid 'plugins.git' fractalColor '#739886' evidence ['internal/plugins/gitstatus/plugin.go'] }
    }

    files = component 'File Browser & Editor' {
      description 'Hierarchical file tree navigation, file preview, and inline text editing.'
      metadata { uid 'plugins.files' fractalColor '#739886' evidence ['internal/plugins/filebrowser/plugin.go'] }
    }

    td = component 'TD Task Monitor' {
      description 'Durable task workflow monitoring, activity logs, and review/approval flows.'
      metadata { uid 'plugins.td' fractalColor '#739886' evidence ['internal/plugins/tdmonitor/plugin.go'] }
    }

    scratchpad = component 'Scratchpad Notes' {
      description 'Quick note taking and scratchpad documents persisted per project.'
      metadata { uid 'plugins.notes' fractalColor '#739886' evidence ['internal/plugins/notes/plugin.go'] }
    }

    external = component 'External Plugin Host' {
      description 'Generic host spawning configured external plugins as short-lived sidecar.plugin/v1 subprocesses. Recall is one such configured plugin (id recall); no Recall-specific code exists in Sidecar.'
      metadata { uid 'plugins.external' fractalColor '#739886' evidence ['internal/pluginhost/protocol.go', 'internal/pluginhost/command.go', 'internal/pluginhost/runner.go'] }
    }
  }

  remoting = subsystem 'Remote Host Orchestration' {
    description 'Orchestrates remote Sidecar instances and transparently executes commands over SSH.'
    metadata { uid 'remoting' fractalColor '#C48282' evidence ['internal/hosts/client.go', 'internal/hostserve/serve.go'] }

    client = component 'SSH Host Client' {
      description 'Manages persistent SSH connections, host verification, and remote command proxying.'
      metadata { uid 'remoting.client' fractalColor '#C48282' evidence ['internal/hosts/client.go', 'internal/hosts/ssh.go'] }
    }

    daemon = service 'Host Daemon (host serve)' {
      description 'Headless daemon serving repo reads, content trees, and shell controls over stdio.'
      metadata { uid 'remoting.daemon' fractalColor '#C48282' evidence ['internal/hostserve/serve.go', 'internal/hostserve/viewers.go'] }
    }

    stream = component 'Remote Content Stream' {
      #proposed
      description 'Direct streaming of remote file trees and git status without SSH filesystem mounts.'
      metadata { uid 'remoting.stream' fractalColor '#C48282' evidence ['docs/plans/active/remote-files-plugin.md', 'docs/plans/active/remote-git-plugin.md'] }
    }
  }

  external = subsystem 'External Systems & Runtimes' {
    description 'Process and network boundaries outside the core Sidecar Go application.'
    metadata { uid 'external' fractalColor '#B59669' evidence ['docs/features.md'] }

    tmux = service 'tmux Server' {
      description 'Dedicated multiplexer server holding PTY sessions, windows, and output ring buffers.'
      metadata { uid 'external.tmux' fractalColor '#B59669' evidence ['internal/tmuxenv/tmuxenv.go'] }
    }

    agents = service 'Agent Runtimes' {
      description 'Autonomous coding agents (Claude Code, Codex, Antigravity, OpenCode, Pi) in shells.'
      metadata { uid 'external.agents' fractalColor '#9A91C4' evidence ['internal/agentintegration/install.go'] }
    }

    providers = adapter 'Terminal Resource Providers' {
      description 'External JSON-over-stdio executables (sidecar-jira, sidecar-github) resolving tokens.'
      metadata { uid 'external.providers' fractalColor '#739886' evidence ['internal/resource/wire.go', 'internal/resource/document.go'] }
    }

    mobile = service 'Mobile Companion Client' {
      summary 'Native iPhone and iPad Sessions app over SSH stdio'
      description 'Native iPhone and iPad Sessions app (the sidecar-mobile repository). It connects over SSH and runs sidecar mobile serve --stdio for the Sessions catalog and one terminal protocol stream per connection; SSH stdio stays its default transport. Push alerts and the events stream are planned (mobile M2, UI API U1), as is moving it from explicit control to presence-based geometry.'
      metadata { uid 'external.mobile' fractalColor '#C48282' evidence ['docs/plans/active/sidecar-mobile.md', 'internal/cli/mobile.go', 'docs/reference/mobile-protocol.md'] }
    }

    tailscale = service 'tailscale serve (tailscaled)' {
      summary 'Tailnet HTTPS proxy that adds the verified login'
      description 'Terminates HTTPS for tailnet devices and proxies to the UI API Tailnet listener, adding the Tailscale-User-Login header. The user runs the tailscale serve command that sidecar api serve --tailnet prints; Sidecar never changes Tailscale configuration.'
      technology 'tailscale serve unix:$STATE/api/tailnet.sock'
      metadata { uid 'external.tailscale' fractalColor '#B59669' evidence ['internal/uiapi/tailnet.go', 'internal/cli/api.go', 'docs/reference/ui-api.md'] }
    }

    untrusted = actor 'Other Origins & Local Users' {
      summary 'Untrusted code that can reach a loopback port'
      description 'Any website open in a browser (cross-site requests, WebSockets without CORS, DNS rebinding) and any other local user or process. All of them can reach a loopback port; the Host, Origin and mutation guards and origin-bound credentials exist to refuse them.'
      metadata { uid 'external.untrusted' fractalColor '#A0A0A0' evidence ['internal/uiapi/guards_test.go', 'docs/reference/ui-api.md'] }
    }
  }

  api = subsystem 'UI API Host (sidecar api serve)' {
    summary 'Headless HTTP and WebSocket API for UIs that are not the TUI'
    description 'One long-running headless process per user exposing Sessions and live terminals over HTTP and WebSocket. It owns transport, trust and the HTTP/WebSocket mapping only: what a Sessions row says and what a terminal stream means belong to the terminal protocol services behind its Backend seam. It never starts, stops or restarts tmux. Untagged children include the implemented server, events, persistent browser pairing, schemas, fixtures, workspaces, content and layouts; #proposed children remain planned work from the UI API plan.'
    metadata { uid 'api' fractalColor '#7F9FC4' evidence ['internal/uiapi/server.go', 'internal/cli/api.go', 'docs/reference/ui-api.md', 'docs/plans/active/sidecar-ui-api.md'] }

    local = component 'Local Listener' {
      summary 'Trusted 0600 Unix socket; pairing and origins only here'
      description 'Unix socket at $STATE/api/api.sock, mode 0600. File permissions limit it to the user, the same trust as the tmux socket, so every request is admitted without auth and without a terminal limit. Pairing codes and origin registration are served only here.'
      technology 'Unix socket, mode 0600'
      metadata { uid 'api.local' fractalColor '#7F9FC4' evidence ['internal/uiapi/server.go', 'internal/uiapi/handler.go'] }
    }

    browser = component 'Browser Listener' {
      summary 'Loopback TCP 127.0.0.1:7861 for browsers on this machine'
      description 'TCP on 127.0.0.1, default port 7861 (--port 0 picks a free one); never a non-loopback address in v0. Admits a bearer token (browser session or paired origin) or a single-use ticket, each bound to one origin, and serves /pair, the pairing exchange and the optional --ui static bundle.'
      technology 'TCP 127.0.0.1:7861'
      metadata { uid 'api.browser' fractalColor '#7F9FC4' evidence ['internal/uiapi/server.go', 'internal/uiapi/auth.go', 'internal/uiapi/pairpage.go', 'internal/uiapi/static.go'] }
    }

    tailnet = component 'Tailnet Listener' {
      summary '0600 Unix socket behind tailscale serve'
      description 'Created only with --tailnet: Unix socket $STATE/api/tailnet.sock, mode 0600, proxied by tailscale serve. It trusts Tailscale-User-Login because only tailscaled can reach that socket; allowed logins come from api.tailnetLogins or the local node owner. The --tailnet-port N loopback fallback is weaker, since any local process can forge the header there, and serve warns when it is used.'
      technology 'Unix socket, mode 0600; --tailnet-port loopback fallback'
      metadata { uid 'api.tailnet' fractalColor '#7F9FC4' evidence ['internal/uiapi/tailnet.go', 'internal/cli/api.go'] }
    }

    guards = component 'Request Guards & Auth' {
      summary 'Host, Origin and mutation guards, then bearer, ticket or tailnet login'
      description 'Always on for Browser and Tailnet and invisible to the owner: exact Host allowlist (421, defeats DNS rebinding), exact Origin allowlist on upgrades and mutations (403), JSON plus X-Sidecar-Request on every mutation, CORS only for paired origins. Then bearer, ticket or tailnet-login authentication and per-client limits of 16 terminals and 16 tickets.'
      metadata { uid 'api.guards' fractalColor '#7F9FC4' evidence ['internal/uiapi/auth.go', 'internal/uiapi/handler.go', 'internal/uiapi/clients.go', 'internal/uiapi/guards_test.go', 'internal/uiapi/limits_test.go'] }
    }

    pairing = component 'Pairing, Sessions & Tickets' {
      summary 'Public-key browser registrations, memory bearers and WebSocket tickets'
      description 'Mints single-use 60-second pairing codes (Local only), exchanges a code and browser public key for an origin-bound registration, issues single-use 30-second WebSocket tickets, and registers, lists or revokes paired origins. Public-key registrations persist in sessions.json with sliding and absolute expiries; a non-extractable IndexedDB key signs a fresh nonce after restart to obtain a 15-minute memory-only bearer. Revocations persist across restarts.'
      metadata { uid 'api.pairing' fractalColor '#7F9FC4' evidence ['internal/uiapi/auth.go', 'internal/uiapi/browserauth.go', 'internal/uiapi/sessions.go', 'internal/uiapi/origins.go', 'internal/uiapi/pairpage.go'] }
    }

    origins = store 'Paired Origins (origins.json)' {
      summary 'Mode-0600 registry of paired origin token hashes'
      description 'Persists paired embedding origins in $STATE/api/origins.json, mode 0600, as origin, token_sha256, scopes and created_at. Only the token hash is kept; full implies every scope; workspace:write grants workspace resources, guarded operations and invalidations; content:read grants content and per-viewer layout preferences without granting terminals.'
      metadata { uid 'api.origins' fractalColor '#7F9FC4' evidence ['internal/uiapi/origins.go'] }
    }

    endpoint = store 'Endpoint Discovery (endpoint.json)' {
      summary 'endpoint.json plus serve.lock for discovery and single instance'
      description 'Mode-0600 $STATE/api/endpoint.json naming PID, version, instance and listener addresses, written once every listener is bound and removed on clean exit, plus an exclusive serve.lock that refuses a second server. CLI verbs and local SDK users discover the server from it; a dead PID means no server.'
      metadata { uid 'api.endpoint' fractalColor '#7F9FC4' evidence ['internal/uiapi/endpoint.go', 'internal/uiapi/server.go'] }
    }

    routes = component 'Route Mux (/api/v0)' {
      summary 'Catalog, workspace, content, layout, pairing and stream routes'
      description 'Versioned routes served identically on all three listeners: hello, sessions (the same code path as sidecar mobile sessions --json), status (byte for byte what sidecar api status --json prints), project workspaces and guarded operations, content and conditional viewer layouts, ws-tickets, pairing, origins and terminal/events upgrades, plus the --ui static bundle with SPA fallback. Each static request resolves a fresh confined root after directory replacement. Errors reuse the CLI refusal vocabulary.'
      metadata { uid 'api.routes' fractalColor '#7F9FC4' evidence ['internal/uiapi/handler.go', 'internal/uiapi/static.go', 'internal/uiapi/errors.go'] }
    }

    terminal = component 'Terminal WebSocket Bridge' {
      summary 'One WebSocket is one unchanged v0 terminal protocol stream'
      description 'GET /api/v0/terminal upgrades to a WebSocket carrying one mobile protocol v0 stream: one JSON envelope per text message, close is end-of-stream and releases the lease, 30-second pings drop half-open peers, and refusals after the upgrade arrive as 44xx close codes. It calls Backend.ServeTerminal once per connection.'
      technology 'WebSocket'
      metadata { uid 'api.terminal' fractalColor '#7F9FC4' evidence ['internal/uiapi/terminal.go', 'internal/cli/mobile_router.go'] }
    }

    events = component 'Events Stream' {
      summary 'Authenticated catalog, attention, workspace, attachment and open-content push'
      description 'GET /api/v0/events uses the terminal trust model on every listener and emits hello, generation-numbered catalog snapshots, needs-input or finished attention, attachment and holder snapshots, workspace resource invalidations, and orderly shutdown. A single hostserve observer reuses manifest watches and desktop agent status collection; remote invalidations come from registry snapshots and diffs. State coalesces in bounded per-client buffers. sidecar api events --stdio bridges the Local socket to JSONL for SSH consumers; Open content panes subscribe through bounded content references and receive livewatch invalidations; watchers are released with each socket. Scope checks isolate catalog and terminals, workspace invalidations and subscribed content. Legacy holder observations share a bounded cache. Native adoption remains separate.'
      metadata { uid 'api.events' fractalColor '#7F9FC4' evidence ['internal/uiapi/events.go', 'internal/uiapi/content_events.go', 'internal/uiapi/holder_cache.go', 'internal/cli/api_events_source.go', 'internal/cli/api_events.go', 'scripts/ui-api-proof.sh', 'docs/reference/ui-api.md'] }
    }

    spec = component 'Contract Spec & Schemas' {
      summary 'sidecar api spec: generated OpenAPI 3.1 and stream schemas'
      description 'The spec command reflects the HTTP wire types and mobileproto envelopes into JSON Schema 2020-12, emits OpenAPI 3.1 with x-streams, and checks the committed document for drift. CLI resource JSON uses the same Go types as HTTP.'
      metadata { uid 'api.spec' fractalColor '#7F9FC4' evidence ['internal/uiapi/spec.go', 'internal/uiapi/wire.go', 'internal/cli/api_spec.go', 'internal/uiapi/spec_test.go', 'docs/reference/ui-api.openapi.json'] }
    }

    fixtures = adapter 'Fixture Backend' {
      summary 'api serve --fixtures: recorded resources and deterministic echo'
      description 'An opt-in Backend serves a recorded Sessions catalog through shared query projection and recorded status metadata. Terminals use the real mobile Service with a synthetic capture/geometry adapter, so validation, resets, ordering and reconnect remain real without tmux. Listener authentication, pairing and routing remain unchanged. History is unavailable in the echo adapter.'
      metadata { uid 'api.fixtures' fractalColor '#7F9FC4' evidence ['internal/uiapi/fixtures.go', 'internal/mobile/fixture.go', 'internal/mobile/service.go', 'testdata/ui-api/v0/SHA256SUMS', 'scripts/ui-api-fixture-proof.sh'] }
    }

    workspace_routes = component 'Workspace Resources & Operations' {
      summary 'Project workspaces, guarded writes and agent operations'
      description 'Project resources use the shared catalog projection and durable shell records. Workspace-write POST routes invoke the CLI command adapters over workspaceops and agentcontrol with explicit owning projects, preserving JSON results, refusal codes and confirmation guards. Remote reads and writes run on the owning host through its CLI. Shared manifest and configuration watchers emit bounded workspace resource invalidations.'
      metadata { uid 'api.workspace_routes' fractalColor '#7F9FC4' evidence ['internal/uiapi/workspace.go', 'internal/cli/api_workspace.go', 'internal/workspacewire/wire.go', 'internal/cli/api_events_source.go', 'docs/reference/ui-api.md'] }
    }

    layouts = store 'Per-Viewer Layout Store' {
      summary 'Locked per-viewer pane trees (U3)'
      description 'GET and conditional PUT of each authenticated viewer and project layout under $STATE/api/layouts. The shared tree format contains ratios and tab references, with no cell geometry. OS locking, ETag comparison and atomic replacement prevent lost writes; the TUI state remains separate.'
      metadata { uid 'api.layouts' fractalColor '#7F9FC4' evidence ['internal/viewerlayout/store.go', 'internal/uiapi/layouts.go', 'internal/panecodec/panecodec.go', 'internal/state/state.go'] }
    }

    viewer_relay = component 'Viewer Relay (uirequest)' {
      #proposed
      summary 'A screen-holding client becomes a target for sidecar open (U4)'
      description 'Planned for U4: an API client that holds the screen announces itself on the uirequest bus as a viewer with uiRequestRelayV1, so sidecar open and sidecar layout apply or move reach it with the same decline-not-queue rules.'
      metadata { uid 'api.viewer_relay' fractalColor '#7F9FC4' evidence ['docs/plans/active/sidecar-ui-api.md', 'internal/uirequest/bus.go'] }
    }
  }

  termproto = subsystem 'Headless Terminal Protocol' {
    summary 'The mobile terminal protocol and the services behind it'
    description 'Serves one tmux pane to a viewer that is not the TUI: target resolution, the shared @sidecar-owner geometry lease, lease-gated input, History, reconnect and cross-host owner forwarding. The same services answer sidecar mobile serve --stdio over SSH and the UI API terminal WebSocket; the UI API plan promotes the protocol to terminal protocol v1 for every client.'
    metadata { uid 'termproto' fractalColor '#C9A06B' evidence ['internal/mobile/service.go', 'internal/mobileproto/protocol.go', 'docs/reference/mobile-protocol.md'] }

    service = service 'Owner Terminal Service' {
      summary 'One bounded protocol stream for a terminal this machine owns'
      description 'mobile.Service runs one stream over any reader and writer. It resolves targets, subscribes through the tmux control manager, renders capture-pane frames (each v0 frame starts with ESC c), gates input on the geometry lease with explicit control and release, serves bounded History, and aborts the stream on an outbound queue overflow.'
      metadata { uid 'termproto.service' fractalColor '#C9A06B' evidence ['internal/mobile/service.go', 'internal/mobile/render.go', 'internal/tty/geometry_lease.go'] }
    }

    catalog = component 'Sessions Catalog' {
      summary 'Sorted, filtered rows of shells and agents'
      description 'Builds the CatalogSnapshot of project shells and agents from configured projects, live tmux panes and agent activity, with shared sorting and filtering. One code path answers sidecar mobile sessions --json, the protocol sessions request and GET /api/v0/sessions.'
      metadata { uid 'termproto.catalog' fractalColor '#C9A06B' evidence ['internal/mobile/catalog.go', 'internal/cli/mobile.go', 'internal/cli/mobile_router.go'] }
    }

    hub = component 'Protocol Broker & Owner Router' {
      summary 'Routes each stream to the Sidecar that owns the terminal'
      description 'mobilehub, active when remote hosts are configured. A fresh ProtocolBroker per stream projects v0 over the owning Sidecar, keeping at most one owner, target and attachment: an in-process service for local terminals, or sidecar mobile serve --stdio --owner-only over a validated SSH route for remote ones. It merges owner catalogs into one cross-host directory and owns no terminal state or leases.'
      metadata { uid 'termproto.hub' fractalColor '#C9A06B' evidence ['internal/mobilehub/broker.go', 'internal/mobilehub/owner.go', 'internal/mobilehub/local.go', 'internal/mobilehub/directory.go', 'internal/cli/mobile_router.go'] }
    }

    presence = component 'Presence Geometry Arbiter' {
      #proposed
      summary 'The screen you are using wins, per attachment (U1)'
      description 'Planned for U1: clients report presence (focus, visibility, idle time, fitted size) instead of control, and the owning service runs the TUI rule DecideGeometryLease for each attachment on every presence change and heartbeat. Typing claims outright; losing focus releases. The explicit control and release operations stay for compatibility.'
      metadata { uid 'termproto.presence' fractalColor '#C9A06B' evidence ['internal/tty/geometry_lease.go', 'docs/plans/active/sidecar-ui-api.md'] }
    }

    frames = component 'Screen-Model Frames (v1)' {
      #proposed
      summary 'Reset-free, coalesced frames from screenmodel'
      description 'Planned for terminal protocol v1: frames that home the cursor instead of ESC c, coalesced latest-wins before the outbound queue, and built from the byte-fed screenmodel the desktop already keeps rather than a capture-pane per output burst. U0 measurements decide whether the screenmodel part lands in U1 or later.'
      metadata { uid 'termproto.frames' fractalColor '#C9A06B' evidence ['internal/tty/screenmodel', 'docs/plans/active/sidecar-ui-api.md'] }
    }
  }

  uiclients = subsystem 'UI API Clients' {
    summary 'Web UIs, embedders and scripts built only on the public API'
    description 'Clients outside the Sidecar binary that use only what any client can use: no private endpoint and no private component API. The sidecar-ui repository (a private pnpm workspace) holds the SDK, the web components and the reference app. It has no Fractal model of its own yet, so its pieces are modeled here from the plan and the wire contract.'
    metadata { uid 'uiclients' fractalColor '#6FA6A0' evidence ['docs/plans/active/sidecar-ui-api.md', 'docs/reference/ui-api.md'] }

    app = component 'sidecar-ui Reference App' {
      summary 'Generic SvelteKit reference UI, a starting point to fork'
      description 'SvelteKit with adapter-static, importing only the two public packages. Served by sidecar api serve --ui DIR or from its own origin. U0 is minimal; the Sessions view, project workspaces and pane trees arrive in U1 to U3.'
      technology 'SvelteKit, adapter-static'
      metadata { uid 'uiclients.app' fractalColor '#6FA6A0' evidence ['docs/plans/active/sidecar-ui-api.md'] }
    }

    elements = component '@marcusv/sidecar-elements' {
      summary 'Framework-agnostic web components such as <sidecar-terminal>'
      description 'Svelte compiled to custom elements, with xterm.js inside <sidecar-terminal>. In U0 the element claims on display while focused, claims on input, releases on blur, and supports readonly. <sidecar-sessions> and <sidecar-workspace> are planned for U1 and U2.'
      technology 'Svelte custom elements, xterm.js'
      metadata { uid 'uiclients.elements' fractalColor '#6FA6A0' evidence ['docs/plans/active/sidecar-ui-api.md'] }
    }

    sdk = component '@marcusv/sidecar-client' {
      summary 'Typed SDK that owns the hard parts of the stream'
      description 'TypeScript SDK for browsers and Node. Its Terminal owns sequencing, heartbeats, hidden control, reconnect, and the ticket or bearer WebSocket upgrade; its Session covers resources.'
      technology 'TypeScript, browser and Node'
      metadata { uid 'uiclients.sdk' fractalColor '#6FA6A0' evidence ['docs/plans/active/sidecar-ui-api.md', 'docs/reference/ui-api.md'] }
    }

    embedder = component 'Embedding Apps (paired origins)' {
      summary 'Another origin embedding Sidecar after api pair --origin'
      description 'An app on its own origin that embeds <sidecar-terminal> after sidecar api pair --origin URL, using the paired bearer token for HTTP and a ticket per WebSocket. Proved in U0 by a second-origin example; clara-home is the expected first outside consumer.'
      metadata { uid 'uiclients.embedder' fractalColor '#6FA6A0' evidence ['docs/reference/ui-api.md', 'docs/plans/active/sidecar-ui-api.md'] }
    }

    scripts = actor 'Agents & Scripts' {
      summary 'Node SDK, curl over the Local socket, sidecar api verbs'
      description 'Non-browser callers: the Node SDK with a bearer token, curl --unix-socket against the Local listener, and sidecar api status, open and pair.'
      metadata { uid 'uiclients.scripts' fractalColor '#6FA6A0' evidence ['docs/reference/ui-api.md', 'internal/tools/uiapiproof'] }
    }
  }

  // Inter-component and cross-boundary relationships
  user .calls tui.app 'Navigates and enters commands' { metadata { uid 'user-tui' } }
  user .calls cli.dispatch 'Runs CLI verbs from shell' { metadata { uid 'user-cli' } }

  tui.app .renders panes.frame 'Composes active view panes' { metadata { uid 'tui-panes' } }
  tui.app .calls workspaces.surface 'Switches active workspace' { metadata { uid 'tui-workspaces' } }
  tui.app .calls plugins.git 'Activates Git view' { metadata { uid 'tui-git' } }
  tui.app .calls plugins.files 'Activates Files view' { metadata { uid 'tui-files' } }
  tui.app .calls plugins.td 'Activates Tasks view' { metadata { uid 'tui-td' } }
  tui.app .calls plugins.scratchpad 'Activates Notes view' { metadata { uid 'tui-notes' } }
  tui.app .renders tui.notify 'Displays toast overlays' { metadata { uid 'tui-app-notify' } }

  tui.overview .reads workspaces.state 'Surfaces all project sessions' { metadata { uid 'overview-state' } }
  tui.overview .renders panes.frame 'Shares layout chrome & preview' { metadata { uid 'overview-panes' } }

  panes.frame .calls panes.layout 'Calculates split coordinates' { metadata { uid 'frame-layout' } }
  panes.live .reads panes.frame 'Checks on-screen pane visibility' { metadata { uid 'live-frame' } }
  panes.live .calls panes.content 'Triggers live re-reads' { metadata { uid 'live-content' } }
  panes.content .renders panes.frame 'Draws file, diff, and note text' { metadata { uid 'content-frame' } }
  panes.content .calls panes.layout 'Requests leaf geometry' { metadata { uid 'content-layout' } }

  workspaces.surface .calls panes.layout 'Applies pane split mutations' { metadata { uid 'ws-layout' } }
  workspaces.surface .calls workspaces.git_ops 'Creates branch worktrees' { metadata { uid 'ws-gitops' } }
  cli.dispatch .calls workspaces.git_ops 'Runs shared workspace mutations' { metadata { uid 'cli-workspaceops' evidence ['internal/cli/create_worktree.go', 'internal/cli/create_shell.go'] } }
  tui.overview .calls workspaces.git_ops 'Runs the same workspace mutations' { metadata { uid 'overview-workspaceops' evidence ['internal/overview/global_create.go', 'internal/overview/global_actions.go'] } }
  workspaces.git_ops .writes workspaces.state 'Persists through shared shellstate writer' { metadata { uid 'workspaceops-shellstate' evidence ['internal/workspaceops/shell.go', 'internal/shellstate/snapshot.go'] } }
  workspaces.surface .writes workspaces.state 'Records live shell identities' { metadata { uid 'ws-state' } }
  workspaces.surface .renders terminal.preview 'Paints terminal pane rows' { metadata { uid 'ws-preview' } }

  workspaces.restore .reads workspaces.state 'Reads shells.json for recovery' { metadata { uid 'restore-state' } }
  workspaces.restore .calls external.tmux 'Recreates missing sessions' { metadata { uid 'restore-tmux' } }

  terminal.preview .reads terminal.control 'Captures rendered screen buffer' { metadata { uid 'preview-control' } }
  terminal.pty .sends terminal.control 'Forwards user keystrokes & clicks' { metadata { uid 'pty-control' } }
  terminal.control .streams external.tmux 'tmux control-mode protocol' { metadata { uid 'control-tmux' } }

  external.tmux .manages external.agents 'Hosts agent process in PTY' { metadata { uid 'tmux-agents' } }

  agents.integration .writes external.agents 'Injects hooks & configs' { metadata { uid 'integration-agent' } }
  external.agents .sends agents.lifecycle 'Emits session lifecycle events' { metadata { uid 'agent-lifecycle' } }
  agents.control .calls agents.lifecycle 'Verifies agent availability' { metadata { uid 'control-lifecycle' } }
  agents.control .supplies agents.catalog 'Reads agent argv definitions' { metadata { uid 'control-catalog' } }
  agents.control .reads agents.adapters 'Extracts conversation turns' { metadata { uid 'control-adapters' } }
  agents.control .sends terminal.pty 'Types prompts & commands' { metadata { uid 'control-pty' } }
  agents.control .reads terminal.preview 'Reads unwrapped output buffer' { metadata { uid 'control-preview' } }

  notifications.store .notifies tui.notify 'Streams alerts to in-app stack' { metadata { uid 'store-toast' } }
  notifications.store .calls notifications.delivery 'Triggers system audio & banners' { metadata { uid 'store-delivery' } }

  cli.dispatch .calls cli.layout_cmd 'Dispatches layout verb' { metadata { uid 'dispatch-layout' } }
  cli.dispatch .calls cli.agent_cmd 'Dispatches agent verb' { metadata { uid 'dispatch-agent' } }
  cli.dispatch .calls cli.open_cmd 'Dispatches open verb' { metadata { uid 'dispatch-open' } }
  cli.dispatch .calls cli.notify_cmd 'Dispatches notify verb' { metadata { uid 'dispatch-notify' } }

  cli.layout_cmd .calls panes.layout 'Queries or modifies layout tree' { metadata { uid 'cli-panes-layout' } }
  cli.agent_cmd .calls agents.control 'Coordinates agent execution' { metadata { uid 'cli-agent-ctl' } }
  cli.open_cmd .calls workspaces.surface 'Opens target beside terminal' { metadata { uid 'cli-ws-open' } }
  cli.notify_cmd .writes notifications.store 'Enqueues notification event' { metadata { uid 'cli-notify-store' } }

  external.providers .supplies panes.content 'Supplies Jira & GitHub documents' { metadata { uid 'providers-content' } }

  remoting.client .calls remoting.daemon 'Executes verbs over SSH' { metadata { uid 'client-daemon' } }
  remoting.daemon .calls workspaces.surface 'Manages remote shells' { metadata { uid 'daemon-ws' } }
  remoting.stream .streams remoting.client 'Streams remote files & diffs' { metadata { uid 'stream-client' } }

  // mobile-tui keeps its stable ID; the app has never streamed through the TUI,
  // it runs sidecar mobile serve --stdio over SSH.
  external.mobile .streams cli.mobile_cmd 'ssh: sidecar mobile serve --stdio' {
    description 'The native app opens an SSH session and runs sidecar mobile serve --stdio, one terminal protocol stream per connection.'
    metadata { uid 'mobile-tui' }
  }
  user .calls external.mobile 'Uses Sessions on iPhone or iPad' { metadata { uid 'user-mobile' } }

  // UI API (U0, current on main at 2f0dc1e7)
  user .calls uiclients.app 'Uses the web UI' { metadata { uid 'user-uiapp' } }
  cli.dispatch .calls cli.api_cmd 'Dispatches api verb' { metadata { uid 'dispatch-api' } }
  cli.dispatch .calls cli.mobile_cmd 'Dispatches mobile verb' { metadata { uid 'dispatch-mobile' } }
  cli.api_cmd .manages api 'Runs sidecar api serve in the foreground' { metadata { uid 'apicmd-host' } }
  cli.api_cmd .reads api.endpoint 'Discovers socket and PID' { metadata { uid 'apicmd-endpoint' } }
  cli.api_cmd .calls api.local 'Pairing codes, origins, status' { metadata { uid 'apicmd-local' } }

  api.local .calls api.routes 'Admits every request (trusted)' { metadata { uid 'local-routes' } }
  api.browser .calls api.guards 'Host, Origin, mutation; bearer or ticket' { metadata { uid 'browser-guards' } }
  api.tailnet .calls api.guards 'Host, Origin, mutation; tailnet login' { metadata { uid 'tailnet-guards' } }
  api.guards .calls api.routes 'Admits an authorized request' { metadata { uid 'guards-routes' } }
  api.guards .reads api.pairing 'Checks session tokens and tickets' { metadata { uid 'guards-pairing' } }
  api.routes .calls api.pairing 'Codes, exchange, tickets, origins' { metadata { uid 'routes-pairing' } }
  api.pairing .writes api.origins 'Persists origin token hashes' { metadata { uid 'pairing-origins' } }
  api.routes .calls api.terminal 'Upgrades GET /api/v0/terminal' { metadata { uid 'routes-terminal' } }
  api.routes .supplies uiclients.app 'Serves the --ui bundle and /pair' { metadata { uid 'routes-uiapp' } }
  api.routes .reads termproto.catalog 'GET /api/v0/sessions (local)' { metadata { uid 'routes-catalog' } }
  api.routes .reads termproto.hub 'Cross-host Sessions when hosts are configured' { metadata { uid 'routes-hub' } }
  api.terminal .streams termproto.service 'One v0 stream per WebSocket, in-process' { metadata { uid 'terminal-service' } }
  api.terminal .streams termproto.hub 'Brokered stream when hosts are configured' { metadata { uid 'terminal-hub' } }

  cli.mobile_cmd .streams termproto.service 'Owner stream on stdio' { metadata { uid 'mobilecmd-service' } }
  cli.mobile_cmd .streams termproto.hub 'Hub stream on stdio' { metadata { uid 'mobilecmd-hub' } }
  cli.mobile_cmd .reads termproto.catalog 'mobile sessions --json' { metadata { uid 'mobilecmd-catalog' } }
  termproto.hub .reads termproto.catalog 'Merges local rows into the directory' { metadata { uid 'hub-catalog' } }
  termproto.hub .streams termproto.service 'Local owner in-process; remote owner via mobile serve --owner-only' { metadata { uid 'hub-service' } }
  termproto.hub .calls remoting.client 'Validates route, builds SSH owner command' { metadata { uid 'hub-hosts' } }
  termproto.service .calls terminal.control 'Subscribes, captures frames, sends input' { metadata { uid 'service-control' } }
  termproto.catalog .reads external.tmux 'Lists panes across project sessions' { metadata { uid 'catalog-tmux' } }

  uiclients.app .calls uiclients.elements 'Composes <sidecar-terminal>' { metadata { uid 'uiapp-elements' } }
  uiclients.embedder .calls uiclients.elements 'Embeds <sidecar-terminal>' { metadata { uid 'embedder-elements' } }
  uiclients.elements .calls uiclients.sdk 'Terminal over the SDK' { metadata { uid 'elements-sdk' } }
  uiclients.sdk .calls api.browser 'Bearer HTTP, ticket WebSocket' { metadata { uid 'sdk-browser' } }
  uiclients.sdk .calls external.tailscale 'HTTPS from a tailnet device' { metadata { uid 'sdk-tailscale' } }
  external.tailscale .calls api.tailnet 'Proxies with Tailscale-User-Login' { metadata { uid 'tailscale-tailnet' } }
  uiclients.scripts .calls uiclients.sdk 'Node SDK with a bearer token' { metadata { uid 'scripts-sdk' } }
  uiclients.scripts .calls api.local 'curl --unix-socket' { metadata { uid 'scripts-local' } }
  uiclients.scripts .calls cli.api_cmd 'sidecar api status, open, pair' { metadata { uid 'scripts-apicmd' } }
  external.untrusted .calls api.browser 'Cross-site, rebinding, other users (refused)' {
    description 'A page or local process can send requests to the loopback port. The Host guard refuses rebinding, the Origin guard refuses other origins, mutations need JSON plus a custom header, and every credential is bound to one origin.'
    metadata { uid 'untrusted-browser' }
  }

  api.routes .streams api.events 'Upgrades GET /api/v0/events' { metadata { uid 'routes-events' evidence 'internal/uiapi/handler.go' } }
  api.events .reads remoting.daemon 'Local manifest and status observations' { metadata { uid 'events-local-observer' evidence 'internal/cli/api_events_source.go' } }
  api.events .reads remoting.client 'Remote inventory and health changes' { metadata { uid 'events-remote-observer' evidence 'internal/cli/api_events_source.go' } }
  api.events .reads terminal.control 'Observed open-session geometry holder' { metadata { uid 'events-holder' evidence 'internal/cli/api_events_source.go' } }
  cli.api_cmd .streams api.events 'Local JSONL bridge for SSH clients' { metadata { uid 'apicmd-events' evidence 'internal/cli/api_events.go' } }
  // U1-c service management (implemented and merged)
  cli.api_cmd .calls cli.api_service 'api service install, uninstall, status' { metadata { uid 'apicmd-service' } }
  cli.api_service .manages api 'Keeps api serve running (launchd or systemd)' { metadata { uid 'apiservice-host' } }

  // UI API roadmap (U1 to U4, proposed)
  uiclients.sdk .streams api.events 'Catalog, attention and invalidation events' { #proposed metadata { uid 'sdk-events' } }
  api.events .reads termproto.catalog 'Generation-numbered catalog changes' { metadata { uid 'events-catalog' } }
  api.events .reads agents.lifecycle 'Attention: needs input or finished' { metadata { uid 'events-attention' } }
  api.events .reads panes.live 'Content invalidation from livewatch' { #proposed metadata { uid 'events-live' } }
  cli.api_cmd .calls api.spec 'sidecar api spec' { metadata { uid 'apicmd-spec' } }
  uiclients.scripts .reads api.spec 'Reads the whole contract' { metadata { uid 'scripts-spec' } }
  api.fixtures .supplies api.routes 'Recorded sessions, no tmux' { metadata { uid 'fixtures-routes' } }
  api.fixtures .supplies api.terminal 'Real protocol, synthetic captures' { metadata { uid 'fixtures-terminal' } }
  termproto.service .calls termproto.presence 'Presence and heartbeats per attachment' { metadata { uid 'service-presence' } }
  termproto.presence .calls terminal.control 'Claims or releases @sidecar-owner' { metadata { uid 'presence-control' } }
  termproto.service .calls termproto.frames 'Reset-free, coalesced frames' { metadata { uid 'service-frames' } }
  termproto.frames .reads terminal.control 'Byte-fed screenmodel, no capture loop' { metadata { uid 'frames-control' } }
  api.routes .calls api.workspace_routes 'Workspace and operation routes' { metadata { uid 'routes-workspaces' } }
  api.workspace_routes .calls workspaces.git_ops 'Create, rename, delete, restore' { metadata { uid 'wsroutes-gitops' } }
  api.workspace_routes .calls agents.control 'Start or prompt agents' { metadata { uid 'wsroutes-agents' } }
  api.routes .writes api.layouts 'Per-viewer pane trees' { metadata { uid 'routes-layouts' } }
  cli.open_cmd .sends api.viewer_relay 'sidecar open reaches a screen-holding client' { metadata { uid 'open-relay' } }
  cli.layout_cmd .sends api.viewer_relay 'layout apply and move' { metadata { uid 'layout-relay' } }
  api.viewer_relay .streams api.events 'Delivers open and layout requests' { metadata { uid 'relay-events' } }
}

views {
  view index {
    include *
  }
}
